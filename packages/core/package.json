{
  "name": "@multimcp/core",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests",
    "test:real-bridges": "MULTIMCP_USE_REAL_BRIDGES=1 MULTIMCP_REAL_BRIDGE_E2E=1 MULTIMCP_MODEL_PROFILE=compat vitest run tests/real-bridges.integration.test.ts",
    "lint": "biome check src tests"
  }
}
